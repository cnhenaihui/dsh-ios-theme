{
  "name": "@cnhenaihui/dsh-theme-wallpaper",
  "version": "2.1.0",
  "type": "module",
  "description": "Theme + wallpaper appearance plugin: 62 OpenCode-derived colour themes (37 built-in plus 25 IP presets, incl. the translucent Lucent Orange), each bringing its own Markdown and syntax-highlight colours, with a contrast-repair layer so every semantic colour stays legible, plus local background images. / 主题 + 壁纸外观插件：62 套源自 OpenCode 的配色主题（37 套内置 + 25 套 IP 预置，含透光橙），每套自带 Markdown 与语法高亮配色，并有一层对比度修复保证语义色可读，另有本地背景图。",
  "license": "MIT",
  "author": "cnhenaihui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnhenaihui/dsh-theme-wallpaper.git"
  },
  "bugs": {
    "url": "https://github.com/cnhenaihui/dsh-theme-wallpaper/issues"
  },
  "homepage": "https://github.com/cnhenaihui/dsh-theme-wallpaper#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "theme",
    "themes",
    "color-theme",
    "wallpaper",
    "background-image",
    "appearance",
    "dark-mode",
    "syntax-highlight",
    "shiki",
    "markdown"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
